# Managed by ansible (role exporter-guard). Only touches tcp {{ exporter_guard_ports | join(', ') }}.
table inet exporter_guard
delete table inet exporter_guard
table inet exporter_guard {
  set allowed4 {
    type ipv4_addr; flags interval
    elements = { {{ exporter_guard_allowed_sources | join(', ') }} }
  }
  chain input {
    type filter hook input priority -10; policy accept;
    ip saddr != @allowed4 tcp dport { {{ exporter_guard_ports | join(', ') }} } drop
    meta nfproto ipv6 iifname != "lo" tcp dport { {{ exporter_guard_ports | join(', ') }} } drop
  }
}
